# VM deployment environment (copy to .env)
# Used by deploy/docker-compose.vm.yml (backend env_file)

NODE_ENV=production
PORT=4001
MONGODB_URI=mongodb://mongo-shared:27017/matchprediction

JWT_ACCESS_SECRET=replace-with-strong-random-string
JWT_REFRESH_SECRET=replace-with-strong-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SUPER_ADMIN_PHONE=+254700000001
SUPER_ADMIN_PASSWORD=replace-with-strong-password
DATA_ADMIN_PHONE=+254700000002
DATA_ADMIN_PASSWORD=replace-with-strong-password
DATA_PIN=1234

BOOTSTRAP_STRICT_MODE=true
CALLBACK_TOKEN=replace-with-random-callback-token

# For IP-first rollout, use "*" to avoid CORS blocks.
# Tighten later to exact origins, e.g. http://<VM_IP>
CORS_ALLOWED_ORIGINS=*

MERCHANT_KE7STG_CALLBACK_URL=
MERCHANT_KE7PROD_CALLBACK_URL=

DO_SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=weedza-storage
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_PUBLIC_BASE_URL=https://weedza-storage.sgp1.digitaloceanspaces.com
DO_SPACES_TEAMS_PREFIX=teams
